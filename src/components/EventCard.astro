---
import type { EventEntry } from '../lib/events';
import { formatEventDate, formatEventTime } from '../lib/events';

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const { title, start, end, location, summary, image, cancelled } = event.data;
const href = `/events/${event.id}`;
---

<a
  href={href}
  class="group block rounded-[var(--radius-card)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
>
  <article
    class="flex flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-surface)] p-6 transition-colors group-hover:border-[var(--color-accent)]/50 md:flex-row md:gap-8"
  >
    {
      image && (
        <img
          src={image}
          alt=""
          loading="lazy"
          class="aspect-[4/3] w-full rounded-xl object-cover md:w-56 md:flex-shrink-0"
        />
      )
    }

    <div class="flex flex-1 flex-col">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-accent)]">
        {formatEventDate(start, end)}
      </p>

      <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-ink)] md:text-2xl">
        {title}
        {
          cancelled && (
            <span class="ml-2 inline-block rounded-full bg-[var(--color-line)] px-2 py-0.5 align-middle text-xs font-medium text-[var(--color-muted)]">
              Cancelled
            </span>
          )
        }
      </h3>

      <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-[var(--color-muted)]">
        <div class="flex items-center gap-1.5">
          <span aria-hidden="true">🕒</span>
          <dt class="sr-only">Time</dt>
          <dd>{formatEventTime(start, end)}</dd>
        </div>

        <div class="flex items-center gap-1.5">
          <span aria-hidden="true">📍</span>
          <dt class="sr-only">Location</dt>
          <dd>{location.name}</dd>
        </div>
      </dl>

      {
        summary && (
          <p class="mt-3 whitespace-pre-line text-[var(--color-ink)]/85">
            {summary}
          </p>
        )
      }

      <p class="mt-4 text-sm font-semibold text-[var(--color-accent)] group-hover:text-[var(--color-accent-soft)]">
        View event →
      </p>
    </div>
  </article>
</a>
